{
  "name": "remix-root",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "admin": "pnpm --filter @remix/admin dev",
    "admin:build": "pnpm --filter @remix/admin build",
    "demo1": "pnpm --filter @remix/demo1 dev",
    "demo1:build": "pnpm --filter @remix/demo1 build",
    "game": "pnpm --filter @remix/game dev",
    "game:build": "pnpm --filter @remix/game build",
    "monitor": "pnpm --filter @remix/monitor dev",
    "monitor:build": "pnpm --filter @remix/monitor build",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,scss,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,scss,md}\"",
    "check-types": "turbo run check-types",
    "clean": "turbo run clean && rimraf node_modules **/node_modules **/dist **/.turbo pnpm-lock.yaml",
    "reinstall": "pnpm run clean && pnpm install"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "rimraf": "^6.1.3",
    "turbo": "^2.9.15",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@11.0.0",
  "engines": {
    "node": ">=18"
  }
}
